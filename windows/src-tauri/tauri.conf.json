{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawvinci",
  "version": "0.1.0",
  "identifier": "com.clawvinci.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Clawvinci",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENkQ2RDk5RDY5RDY5RDkKUldUS0tZdVlXMWxsVW1WbVlXTnZjR1ZwWW1WcllXTnZlV052Y0dWcFltVnIK",
      "endpoints": [
        "https://github.com/HasNetwork/Clawvinci/releases/latest/download/latest.json"
      ]
    }
  }
}
